# Configuración local segura. Copia este archivo como .env si necesitas cambiarla.
RENFE_NOTIFIER_ENVIRONMENT=development
RENFE_NOTIFIER_HOST=127.0.0.1
RENFE_NOTIFIER_PORT=8000
RENFE_NOTIFIER_DEBUG=false

# Obligatoria únicamente cuando RENFE_NOTIFIER_ENVIRONMENT=production.
# Genera un valor localmente; nunca lo guardes en Git.
# RENFE_NOTIFIER_SECRET_KEY=

# Ruta del fichero SQLite. Debe apuntar a un directorio de datos (fuera de app/)
# que no se reemplace en despliegues; en producción se monta como volumen Docker.
# RENFE_NOTIFIER_DATABASE_PATH=data/renfe-notifier.db

# Recordatorios de la cola de avisos: retraso del primer recordatorio,
# separación mínima entre recordatorios y tope de recordatorios por evento.
# RENFE_NOTIFIER_REMINDER_INITIAL_DELAY_S=60
# RENFE_NOTIFIER_REMINDER_INTERVAL_S=300
# RENFE_NOTIFIER_REMINDER_MAX_ATTEMPTS=3

# Emparejamiento: caducidad del código OTP y límite de reclamaciones por código.
# RENFE_NOTIFIER_PAIRING_CODE_TTL_S=600
# RENFE_NOTIFIER_PAIRING_MAX_ATTEMPTS=3

# Limitación de peticiones del endpoint de emparejamiento (por IP, en memoria).
# RENFE_NOTIFIER_RATE_LIMIT_WINDOW_S=60
# RENFE_NOTIFIER_RATE_LIMIT_MAX_REQUESTS=10

# FCM HTTP v1 (paso 19): el ID de proyecto de Firebase es obligatorio para
# habilitar el envío. Las credenciales se resuelven en tiempo de ejecución con
# Application Default Credentials (identidad de la VM, o cuenta de servicio vía
# GOOGLE_APPLICATION_CREDENTIALS y `pip install google-auth` para local).
# RENFE_NOTIFIER_FCM_PROJECT_ID=
# RENFE_NOTIFIER_FCM_TIMEOUT_S=10
# RENFE_NOTIFIER_FCM_DEFAULT_TTL_S=300
# RENFE_NOTIFIER_FCM_APP_PACKAGE=
