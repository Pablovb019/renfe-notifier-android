<?xml version="1.0" encoding="utf-8"?>
<!--
  Restricción de tráfico en claro: HTTPS obligatorio en producción.
  Solo se permite HTTP sin cifrar hacia el bucle local (entorno de desarrollo
  y MockWebServer), jamás hacia hosts remotos.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="false">34.73.192.35</domain>
    </domain-config>
</network-security-config>